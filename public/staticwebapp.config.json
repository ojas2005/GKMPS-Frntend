{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{js,css,json,svg,png,jpg,jpeg,gif,ico,webp,woff,woff2,txt,map}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    {
      "route": "/config.json",
      "headers": { "Cache-Control": "no-store" }
    }
  ]
}
